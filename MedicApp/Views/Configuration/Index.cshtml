@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@model ConfigurationForm
@{ViewData["Title"] = T["Configuration"]; var zones=(string[])ViewBag.TimeZones;}
<div class="page-heading"><div><h1><medic-icon name="settings"/>@T["ApplicationConfiguration"]</h1><p>@T["AllConfigurationHelp"]</p></div><a class="btn btn-outline-secondary" asp-action="Index"><medic-icon name="refresh"/>@T["ReloadConfiguration"]</a></div>
<div class="configuration-layout">
<nav class="panel configuration-nav" aria-label="@T["ConfigurationSections"]"><h2 class="h5">@T["ConfigurationSections"]</h2><a href="#general"><medic-icon name="settings"/>@T["ConfigurationGeneral"]</a><a href="#appointments"><medic-icon name="calendar"/>@T["ConfigurationAppointments"]</a><a href="#documents"><medic-icon name="paperclip"/>@T["ConfigurationDocuments"]</a><a href="#clinical"><medic-icon name="folder"/>@T["ClinicalRecords"]</a><a href="#inventory"><medic-icon name="inventory"/>@T["Inventory"]</a><a href="#administration"><medic-icon name="shield"/>@T["ConfigurationAdministration"]</a><a href="#demo"><medic-icon name="info"/>@T["DemoData"]</a></nav>
<div>
<form asp-action="Index" method="post" id="application-configuration-form">
<input asp-for="Revision" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<section class="panel configuration-section" id="general"><h2><medic-icon name="settings"/>@T["ConfigurationGeneral"]</h2>
<div class="row g-3"><div class="col-md-6"><label asp-for="General.DisplayName" class="form-label">@T["ApplicationDisplayName"]</label><input asp-for="General.DisplayName" class="form-control" maxlength="80" required/><span asp-validation-for="General.DisplayName" class="text-danger"></span><p class="form-text">@T["ApplicationNameHelp"]</p></div>
<div class="col-md-6"><label asp-for="General.TimeZoneId" class="form-label">@T["ApplicationTimeZone"]</label><select asp-for="General.TimeZoneId" class="form-select" required>@foreach(var zone in zones){var label=T["Zone_"+zone.Replace('/','_')];<option value="@zone">@(label.ResourceNotFound?zone:label.Value+" ("+zone+")")</option>}</select><span asp-validation-for="General.TimeZoneId" class="text-danger"></span></div></div><p class="form-text">@T["ApplicationZoneHelp"]</p></section>
<section class="panel configuration-section" id="appointments"><h2><medic-icon name="calendar"/>@T["ConfigurationAppointments"]</h2><p>@T["ConfigurationHelp"]</p>
<div class="row g-3"><div class="col-md-6"><label asp-for="BookingHorizonDays" class="form-label">@T["BookingHorizonDays"]</label><input asp-for="BookingHorizonDays" class="form-control" min="1" max="365"/><span asp-validation-for="BookingHorizonDays" class="text-danger"></span><div class="form-text">@T["HorizonHelp"]</div></div>
<div class="col-md-6"><label asp-for="DefaultSlotMinutes" class="form-label">@T["DefaultSlotMinutes"]</label><input asp-for="DefaultSlotMinutes" class="form-control" min="5" max="30"/><span asp-validation-for="DefaultSlotMinutes" class="text-danger"></span><div class="form-text">@T["DurationHelp"]</div></div></div>
<div class="form-check form-switch my-3"><input asp-for="Open24Hours" class="form-check-input"/><label asp-for="Open24Hours" class="form-check-label">@T["Open24Hours"]</label></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="OpeningTime" class="form-label">@T["OpeningTime"]</label><input asp-for="OpeningTime" type="time" class="form-control"/><span asp-validation-for="OpeningTime" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ClosingTime" class="form-label">@T["ClosingTime"]</label><input asp-for="ClosingTime" type="time" class="form-control"/><span asp-validation-for="ClosingTime" class="text-danger"></span></div></div><p class="form-text">@T["ServiceHoursHelp"]</p>
<div class="form-check form-switch mt-3"><input asp-for="DemoBookingEnabled" class="form-check-input"/><label asp-for="DemoBookingEnabled" class="form-check-label">@T["DemoBookingEnabled"]</label><div class="form-text">@T["DemoBookingHelp"]</div></div>
</section>
<section class="panel configuration-section" id="documents"><h2><medic-icon name="paperclip"/>@T["ConfigurationDocuments"]</h2><p>@T["DocumentConfigurationHelp"]</p>
<div class="row g-3"><div class="col-md-4"><label asp-for="Documents.MaxFileSizeMb" class="form-label">@T["MaxFileSizeMb"]</label><input asp-for="Documents.MaxFileSizeMb" type="number" min="1" max="10" class="form-control"/><span asp-validation-for="Documents.MaxFileSizeMb" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Documents.MaxBatchSizeMb" class="form-label">@T["MaxBatchSizeMb"]</label><input asp-for="Documents.MaxBatchSizeMb" type="number" min="1" max="20" class="form-control"/><span asp-validation-for="Documents.MaxBatchSizeMb" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Documents.MaxFilesPerUpload" class="form-label">@T["MaxFilesPerUpload"]</label><input asp-for="Documents.MaxFilesPerUpload" type="number" min="1" max="5" class="form-control"/><span asp-validation-for="Documents.MaxFilesPerUpload" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Documents.MaxDocumentsPerLeave" class="form-label">@T["MaxDocumentsPerLeave"]</label><input asp-for="Documents.MaxDocumentsPerLeave" type="number" min="1" max="100" class="form-control"/><span asp-validation-for="Documents.MaxDocumentsPerLeave" class="text-danger"></span></div></div>
<p class="form-text">@T["DocumentLimitsHelp"]</p><a asp-controller="Leaves" asp-action="Index" class="btn btn-outline-secondary"><medic-icon name="clipboard"/>@T["LeaveRegistry"]</a> <a asp-controller="LeaveDocuments" asp-action="Record" class="btn btn-outline-secondary"><medic-icon name="folder"/>@T["PatientFile"]</a>
</section>
<section class="panel configuration-section" id="clinical"><h2><medic-icon name="folder"/>@T["ClinicalRecords"]</h2><p>@T["ClinicalConfigurationHelp"]</p>
<div class="row g-3"><div class="col-md-6"><label asp-for="Documents.MaxDocumentsPerPatient" class="form-label">@T["MaxDocumentsPerPatient"]</label><input asp-for="Documents.MaxDocumentsPerPatient" type="number" min="1" max="1000" class="form-control"/><span asp-validation-for="Documents.MaxDocumentsPerPatient" class="text-danger"></span></div></div><p class="form-text">@T["ClinicalLimitsHelp"]</p><a asp-controller="ClinicalRecords" asp-action="Index" class="btn btn-outline-secondary"><medic-icon name="folder"/>@T["OpenClinicalModule"]</a>
</section>
<section class="panel configuration-section" id="inventory"><h2><medic-icon name="inventory"/>@T["Inventory"]</h2><p>@T["InventoryConfigurationHelp"]</p>
<div class="row g-3"><div class="col-md-6"><label asp-for="Inventory.ExpiryWarningDays" class="form-label">@T["ExpiryWarningDays"]</label><input asp-for="Inventory.ExpiryWarningDays" type="number" min="1" max="365" class="form-control"/><span asp-validation-for="Inventory.ExpiryWarningDays" class="text-danger"></span></div></div><p class="form-text">@T["InventoryRulesHelp"]</p><a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-secondary"><medic-icon name="inventory"/>@T["OpenInventoryCatalog"]</a>
</section>
<section class="panel configuration-save"><p>@T["ConfigurationPersistenceHelp"]</p><button class="btn btn-primary"><medic-icon name="save"/>@T["SaveAllConfiguration"]</button> <a asp-action="Index" class="btn btn-outline-secondary"><medic-icon name="refresh"/>@T["ReloadConfiguration"]</a></section>
</form>
<section class="panel configuration-section" id="administration"><h2><medic-icon name="shield"/>@T["ConfigurationAdministration"]</h2><p>@T["AdministrationConfigurationHelp"]</p><div class="configuration-links">
@if((await Authorization.AuthorizeAsync(User,"Doctors")).Succeeded){<a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Doctors"><medic-icon name="stethoscope"/>@T["Doctors"]</a>}
<a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Access"><medic-icon name="shield"/>@T["Access"]</a><a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Audit"><medic-icon name="history"/>@T["Audit"]</a><a class="btn btn-outline-secondary" asp-controller="Help" asp-action="Index"><medic-icon name="document"/>@T["HelpManual"]</a></div></section>
<section class="panel configuration-section" id="demo"><h2><medic-icon name="info"/>@T["DemoData"]</h2><p>@T["DemoHelp"]</p><a class="btn btn-outline-primary" asp-action="Demo">@T["ViewDemo"]</a><form asp-action="GenerateDemo" method="post" class="mt-3" data-confirm="@T["ConfirmAction"]"><button class="btn btn-outline-secondary"><medic-icon name="plus"/>@T["GenerateDemo"]</button></form></section>
</div></div>
