@model ConfigurationForm
@{ViewData["Title"] = T["Configuration"];}
<div class="page-heading"><div><h1><medic-icon name="settings"/>@T["Configuration"]</h1><p class="text-muted">@T["ConfigurationHelp"]</p></div></div>
<div class="row g-4"><div class="col-lg-8"><section class="card p-4"><h2 class="h4">@T["AppointmentSettings"]</h2>
<form method="post" asp-action="Index">
<div asp-validation-summary="All" class="text-danger" role="alert"></div><input type="hidden" asp-for="Revision"/>
<div class="mb-3"><label asp-for="BookingHorizonDays" class="form-label"></label><input asp-for="BookingHorizonDays" class="form-control" min="1" max="365"/><span asp-validation-for="BookingHorizonDays" class="text-danger"></span><div class="form-text">@T["HorizonHelp"]</div></div>
<div class="form-check form-switch mb-3"><input asp-for="Open24Hours" class="form-check-input"/><label asp-for="Open24Hours" class="form-check-label"></label></div>
<div class="row g-3 mb-3"><div class="col-sm-6"><label asp-for="OpeningTime" class="form-label"></label><input asp-for="OpeningTime" type="time" class="form-control"/></div><div class="col-sm-6"><label asp-for="ClosingTime" class="form-label"></label><input asp-for="ClosingTime" type="time" class="form-control"/></div><div class="form-text">@T["ServiceHoursHelp"]</div></div>
<div class="mb-4"><label asp-for="DefaultSlotMinutes" class="form-label"></label><input asp-for="DefaultSlotMinutes" class="form-control" min="5" max="30"/><div class="form-text">@T["DurationHelp"]</div></div>
<div class="form-check form-switch mb-4"><input asp-for="DemoBookingEnabled" class="form-check-input"/><label asp-for="DemoBookingEnabled" class="form-check-label"></label><div class="form-text">@T["DemoBookingHelp"]</div></div><button class="btn btn-primary"><medic-icon name="check"/>@T["Save"]</button>
</form></section></div><div class="col-lg-4"><section class="card p-4"><h2 class="h4"><medic-icon name="calendar"/>@T["DemoData"]</h2><p>@T["DemoHelp"]</p><a class="btn btn-outline-primary" asp-action="Demo">@T["ViewDemo"]</a><form asp-action="GenerateDemo" method="post" class="mt-3"><button class="btn btn-outline-secondary"><medic-icon name="plus"/>@T["GenerateDemo"]</button></form></section></div></div>
