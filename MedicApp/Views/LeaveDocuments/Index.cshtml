@model EvidencePage
@{ViewData["Title"]=T["LeaveEvidence"];}
<div class="page-heading"><div><h1><medic-icon name="document"/>@T["LeaveEvidence"]</h1><p>@Model.Person</p></div><a class="btn btn-outline-secondary" asp-controller="Leaves" asp-action="Index"><medic-icon name="list"/>@T["BackToLeaveRegistry"]</a></div>
<section class="panel"><dl class="row"><dt class="col-sm-3">@T["Reference"]</dt><dd class="col-sm-9">@Model.Leave.Reference</dd><dt class="col-sm-3">@T["Start"]</dt><dd class="col-sm-9">@Clock.Local(Model.Leave.StartsAt).ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-sm-3">@T["End"]</dt><dd class="col-sm-9">@Clock.Local(Model.Leave.EndsAt).ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-sm-3">@T["Status"]</dt><dd class="col-sm-9">@T[Model.Leave.Status.ToString()]</dd></dl><a class="btn btn-outline-primary" asp-action="Record" asp-route-personId="@Model.Leave.PersonId"><medic-icon name="folder"/>@T["PatientFile"]</a></section>
@if(Model.CanUpload){<section class="panel"><h2 class="h4"><medic-icon name="upload"/>@T["AttachEvidence"]</h2><p>@T["EvidenceUploadHelp", Model.Limits.MaxFileSizeMb, Model.Limits.MaxFilesPerUpload, Model.Limits.MaxBatchSizeMb, Model.Limits.MaxDocumentsPerLeave]</p><form asp-action="Upload" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input type="hidden" name="LeaveId" value="@Model.Leave.Id"/><input type="hidden" name="RequestKey" value="@Guid.NewGuid()"/><label for="evidence-files" class="form-label">@T["EvidenceFiles"]</label><input id="evidence-files" type="file" name="Files" class="form-control mb-3" accept=".pdf,.jpg,.jpeg,.png" multiple required/><button class="btn btn-primary"><medic-icon name="upload"/>@T["SaveEvidence"]</button></form></section>}
<section class="panel"><h2 class="h4">@T["EvidenceFiles"]</h2>@if(Model.Documents.Count==0){<p role="status">@T["NoEvidence"]</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>@T["DocumentName"]</th><th>@T["AddedAt"]</th><th>@T["DocumentSize"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var document in Model.Documents){<tr><td><medic-icon name="document"/>@document.Name</td><td>@Clock.Local(document.AddedAt).ToString("dd/MM/yyyy HH:mm")</td><td>@((document.ByteCount / 1024m).ToString("N1")) KB</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Download" asp-route-id="@document.Id"><medic-icon name="document"/>@T["ConsultEvidence"]</a></td></tr>}</tbody></table></div>}</section>
