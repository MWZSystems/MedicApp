@model PatientFilePage
@{ViewData["Title"]=T["PatientFile"];}
<div class="page-heading"><div><h1><medic-icon name="folder"/>@T["PatientFile"]</h1><p>@T["PatientFileHelp"]</p></div><a class="btn btn-outline-secondary" asp-controller="Leaves" asp-action="Index"><medic-icon name="chevron-left"/>@T["BackToLeaveRegistry"]</a></div>
@if(Model.CanSearch){<section class="panel"><form method="get" asp-action="Record" class="row g-3 align-items-end"><div class="col-md-9"><label for="record-person" class="form-label"><medic-icon name="search"/>@T["SearchLeavePerson"]</label><select id="record-person" name="personId" data-search-url="@Url.Action("CalendarPeople", "Leaves")" class="form-select" required><option value="">@T["SearchLeavePersonHint"]</option>@if(Model.Person!=null){<option value="@Model.Person.Id" selected>@Model.Person.Label</option>}</select></div><div class="col-md-3"><button class="btn btn-primary w-100"><medic-icon name="folder"/>@T["ShowPatientFile"]</button></div></form></section>}
@if(Model.Person==null){<p class="alert alert-info">@T["ChooseRecordPerson"]</p>}else{<section class="panel"><h2 class="h4">@Model.Person.Label</h2><div class="table-responsive"><table class="table"><thead><tr><th><medic-icon name="file-check"/>@T["Reference"]</th><th><medic-icon name="calendar"/>@T["Start"]</th><th><medic-icon name="calendar"/>@T["End"]</th><th><medic-icon name="info"/>@T["Status"]</th><th><medic-icon name="paperclip"/>@T["EvidenceFiles"]</th></tr></thead><tbody>@foreach(var leave in Model.Records.Items){<tr><td>@leave.Reference</td><td>@Clock.Local(leave.StartsAt).ToString("dd/MM/yyyy HH:mm")</td><td>@Clock.Local(leave.EndsAt).ToString("dd/MM/yyyy HH:mm")</td><td>@T[leave.Status.ToString()]</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-leaveId="@leave.Id"><medic-icon name="document"/>@T["EvidenceCount", Model.DocumentCounts.GetValueOrDefault(leave.Id)]</a></td></tr>}</tbody></table></div>@if(Model.Records.Total==0){<p>@T["NoRecordLeaves"]</p>}<nav class="pager" aria-label="@T["Page"]"><span>@T["Total"]: @Model.Records.Total</span>@if(Model.Records.Page>1){<a class="btn btn-outline-secondary" asp-route-personId="@Model.Person.Id" asp-route-page="@(Model.Records.Page-1)"><medic-icon name="chevron-left"/>@T["Previous"]</a>}@if(Model.Records.Page*25<Model.Records.Total){<a class="btn btn-outline-secondary" asp-route-personId="@Model.Person.Id" asp-route-page="@(Model.Records.Page+1)"><medic-icon name="chevron-right"/>@T["Next"]</a>}</nav></section>}
