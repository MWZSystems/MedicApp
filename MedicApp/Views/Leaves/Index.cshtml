@model ListPage<MedicalLeave>
@{ ViewData["Title"] = T["LeaveRegistry"]; var evidenceCounts = (Dictionary<int,int>)ViewBag.DocumentCounts; }
<partial name="_LeaveNavigation"/>
<div class="page-heading"><h1><medic-icon name="heart"/>@T["LeaveRegistry"]</h1><a class="btn btn-outline-primary" asp-action="Calendar"><medic-icon name="calendar"/>@T["LeaveCalendar"]</a>@if(ViewBag.CanRegister == true){<a class="btn btn-primary" asp-action="Create"><medic-icon name="plus"/>@T["AddLeave"]</a>}</div><p>@(Model.CurrentDoctorId != null ? T["LeaveRegistryDoctorHelp"] : (ViewBag.CanRegister == true ? T["LeaveRegistryAdminHelp"] : T["LeaveRegistryReaderHelp"]))</p><section class="panel"><partial name="_Range" model="Model"/><div class="table-responsive"><table class="table" data-local-table><thead><tr><th>@T["Reference"]</th><th>@T["Employee"]</th><th>@T["Start"]</th><th>@T["End"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var row in Model.Items){<tr><td>@row.Reference</td><td>@Model.People.GetValueOrDefault(row.PersonId)</td><td>@Clock.Local(row.StartsAt).ToString("dd/MM/yyyy HH:mm")</td><td>@Clock.Local(row.EndsAt).ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge status-@row.Status">@T[row.Status.ToString()]</span></td><td><a class="btn btn-sm btn-outline-secondary mb-2" asp-controller="LeaveDocuments" asp-action="Index" asp-route-leaveId="@row.Id"><medic-icon name="document"/>@T["EvidenceCount", evidenceCounts.GetValueOrDefault(row.Id)]</a><a class="btn btn-sm btn-outline-secondary mb-2" asp-controller="LeaveDocuments" asp-action="Record" asp-route-personId="@row.PersonId"><medic-icon name="folder"/>@T["PatientFile"]</a>@if(Model.CurrentDoctorId==row.DoctorId && row.Status!=LeaveStatus.Cancelled){<details><summary>@T["Actions"]</summary><form asp-action="Change" method="post" data-confirm="@T["ConfirmAction"]" data-confirm-text="@T["ConfirmDetail"]"><input type="hidden" name="Id" value="@row.Id"/><input type="hidden" name="Version" value="@Convert.ToBase64String(row.RowVersion)"/><label for="status-@row.Id">@T["Status"]</label><select id="status-@row.Id" name="Status" class="form-select">@if(row.Status==LeaveStatus.Draft){<option value="2">@T["Approve"]</option>}<option value="3">@T["Cancel"]</option></select><label for="reason-@row.Id">@T["Reason"]</label><input id="reason-@row.Id" name="Reason" required maxlength="500" class="form-control mb-2"/><button class="btn btn-outline-primary">@T["Save"]</button></form></details>}@if(row.Status==LeaveStatus.Approved){<a class="btn btn-sm btn-outline-primary mt-2" asp-action="Calendar" asp-route-personId="@row.PersonId"><medic-icon name="calendar"/>@T["ShowLeaveCalendar"]</a>}</td></tr>}</tbody></table></div><partial name="_Pager" model="Model"/></section><p class="text-muted">@T["IntegrationNotice"]</p>
