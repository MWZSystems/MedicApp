@model LeaveForm
@{ ViewData["Title"] = T["CreateLeave"]; }
<partial name="_LeaveNavigation"/>
<div class="page-heading"><h1><medic-icon name="heart"/>@T["AddLeave"]</h1><a class="btn btn-outline-secondary" asp-action="Index"><medic-icon name="list"/>@T["BackToLeaveRegistry"]</a></div><section class="panel"><p>@T["LeaveEntryHelp"]</p><form method="post" class="row g-3"><div asp-validation-summary="All"></div><div class="col-md-6"><label asp-for="PersonId" class="form-label">@T["Employee"]</label><select asp-for="PersonId" data-search-url="@Url.Action("Search","People")" class="form-select" required><option value="">@T["SearchHint"]</option>@if(ViewBag.SelectedPerson is string selectedPerson){<option value="@Model.PersonId" selected>@selectedPerson</option>}</select></div>@if(ViewBag.IsDoctor != true){<div class="col-md-6"><label asp-for="DoctorId" class="form-label">@T["ResponsibleDoctor"]</label><select asp-for="DoctorId" data-search-url="@Url.Action("ResponsibleDoctors")" class="form-select" required><option value="">@T["SearchHint"]</option>@if(ViewBag.SelectedDoctor is string selectedDoctor){<option value="@Model.DoctorId" selected>@selectedDoctor</option>}</select><span asp-validation-for="DoctorId" class="text-danger"></span><p class="form-text">@T["ResponsibleDoctorHelp"]</p>@if(ViewBag.CanManageDoctors == true){<a asp-controller="Admin" asp-action="Doctors">@T["ConfigureDoctors"]</a>}</div>}<div class="col-md-6"><label asp-for="Reference" class="form-label">@T["Reference"]</label><input asp-for="Reference" class="form-control"/></div><div class="col-md-6"><label asp-for="StartsAt" class="form-label">@T["Start"]</label><input asp-for="StartsAt" type="datetime-local" class="form-control" required/></div><div class="col-md-6"><label asp-for="EndsAt" class="form-label">@T["End"]</label><input asp-for="EndsAt" type="datetime-local" class="form-control" required/></div><div class="col-md-6"><label asp-for="AppointmentId" class="form-label">@T["Appointment"]</label><input asp-for="AppointmentId" class="form-control"/></div><div class="col-12"><p class="alert alert-info"><medic-icon name="document"/>@T["EvidenceAfterCapture"]</p><button class="btn btn-primary"><medic-icon name="check"/>@T["Save"]</button></div></form></section>
