@model LeaveForm
@{ ViewData["Title"] = T["CreateLeave"]; }
<h1><medic-icon name="heart"/>@T["CreateLeave"]</h1><section class="panel"><p>@T["LeaveHelp"]</p><form method="post" class="row g-3"><div asp-validation-summary="All"></div><div class="col-md-6"><label asp-for="PersonId" class="form-label">@T["Employee"]</label><select asp-for="PersonId" data-search-url="@Url.Action("Search","People")" class="form-select" required><option value="">@T["SearchHint"]</option></select></div><div class="col-md-6"><label asp-for="Reference" class="form-label">@T["Reference"]</label><input asp-for="Reference" class="form-control"/></div><div class="col-md-6"><label asp-for="StartsAt" class="form-label">@T["Start"]</label><input asp-for="StartsAt" type="datetime-local" class="form-control" required/></div><div class="col-md-6"><label asp-for="EndsAt" class="form-label">@T["End"]</label><input asp-for="EndsAt" type="datetime-local" class="form-control" required/></div><div class="col-md-6"><label asp-for="AppointmentId" class="form-label">@T["Appointment"]</label><input asp-for="AppointmentId" class="form-control"/></div><div class="col-12"><button class="btn btn-primary"><medic-icon name="check"/>@T["Save"]</button></div></form></section>
