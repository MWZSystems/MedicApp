@using Microsoft.Extensions.Options
@inject IOptions<InventoryOptions> InventorySettings
@model ListPage<StockItem>
@{ViewData["Title"]=T["Inventory"];var today=DateOnly.FromDateTime(Clock.Local(Clock.UtcNow));}
<div class="page-heading"><div><h1><medic-icon name="inventory"/>@T["Inventory"]</h1><p>@T["InventoryHelp"]</p></div><a class="btn btn-primary" asp-action="Create"><medic-icon name="plus"/>@T["AddStockItem"]</a></div>
<section class="panel"><form method="get" class="row g-3 align-items-end"><div class="col-md-9"><label for="stock-query" class="form-label"><medic-icon name="search"/>@T["SearchStock"]</label><input id="stock-query" name="query" value="@Model.Query" maxlength="80" class="form-control"/></div><div class="col-md-3"><button class="btn btn-primary"><medic-icon name="search"/>@T["Search"]</button></div></form></section>
<section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>@T["StockCode"]</th><th>@T["StockName"]</th><th>@T["StockLot"]</th><th>@T["ExpiresOn"]</th><th>@T["CurrentStock"]</th><th>@T["MinimumStock"]</th><th>@T["Actions"]</th></tr></thead><tbody>
@foreach(var row in Model.Items){<tr><td>@row.Code</td><td>@row.Name</td><td>@row.Lot</td><td>@row.ExpiresOn?.ToString("dd/MM/yyyy") @if(row.ExpiresOn<today){<span class="badge bg-danger">@T["Expired"]</span>}else if(row.ExpiresOn<=today.AddDays(InventorySettings.Value.ExpiryWarningDays)){<span class="badge bg-warning text-dark">@T["ExpiringSoonDays", InventorySettings.Value.ExpiryWarningDays]</span>}</td><td>@row.CurrentStock.ToString("0.###") @row.Unit @if(row.CurrentStock<=row.MinimumStock){<span class="badge bg-warning text-dark">@T["LowStock"]</span>}</td><td>@row.MinimumStock.ToString("0.###")</td><td><a asp-action="Item" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary"><medic-icon name="history"/>@T["StockMovements"]</a></td></tr>}
</tbody></table></div>@if(Model.Total==0){<p>@T["NoRecords"]</p>}<nav class="pager"><span>@T["Total"]: @Model.Total</span>@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-route-query="@Model.Query" asp-route-page="@(Model.Page-1)">@T["Previous"]</a>}@if(Model.Page*25<Model.Total){<a class="btn btn-outline-secondary" asp-route-query="@Model.Query" asp-route-page="@(Model.Page+1)">@T["Next"]</a>}</nav></section>
