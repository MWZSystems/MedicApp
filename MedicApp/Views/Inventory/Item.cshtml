@model StockItemPage
@{ MwzShell.Use(Context, MwzLibraries.Validation | MwzLibraries.Select2); }
@{ViewData["Title"]=T["StockMovements"];}
<div class="page-heading"><div><h1><medic-icon name="inventory"/>@Model.Item.Name</h1><p>@Model.Item.Code · @T["StockLot"]: @Model.Item.Lot · @T["ExpiresOn"]: @Model.Item.ExpiresOn?.ToString("dd/MM/yyyy")</p></div></div>
<section class="panel"><h2 class="h4">@T["CurrentStock"]: @Model.Item.CurrentStock.ToString("0.###") @Model.Item.Unit</h2><p>@T["MinimumStock"]: @Model.Item.MinimumStock.ToString("0.###")</p>@if(!Model.Item.Available){<span class="badge bg-secondary">@T["ListInactive"]</span>}
@if(Model.Item.Available){<h2 class="h4"><medic-icon name="plus"/>@T["AddStockMovement"]</h2><p>@T["StockMovementHelp"]</p><div asp-validation-summary="All" class="text-danger"></div>
<form method="post" asp-action="Move" class="row g-3" data-mwz-texto-carga="@T["LoadingStockMove"]"><input type="hidden" name="StockItemId" value="@Model.Item.Id"/><input type="hidden" name="RequestKey" value="@Model.Form.RequestKey"/>
<div class="col-md-4"><label for="move-kind" class="form-label">@T["MovementKind"]</label><select id="move-kind" name="Kind" class="form-select" required><option value="">@T["ChooseOption"]</option>@foreach(var kind in Enum.GetValues<StockMovementKind>()){<option value="@((int)kind)" selected="@(kind==Model.Form.Kind)">@T["Stock"+kind]</option>}</select></div>
<div class="col-md-4"><label for="move-quantity" class="form-label">@T["Quantity"] (@Model.Item.Unit)</label><input id="move-quantity" name="Quantity" type="number" step="0.001" min="0.001" max="999999999" value="@Model.Form.Quantity.ToString("0.###",System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required/></div>
<div class="col-md-12"><label for="move-reason" class="form-label">@T["MovementReason"]</label><textarea id="move-reason" name="Reason" maxlength="1000" class="form-control" required>@Model.Form.Reason</textarea></div><div class="col-12"><button class="btn btn-primary"><medic-icon name="save"/>@T["Save"]</button></div></form>}</section>
<section class="panel"><h2 class="h4"><medic-icon name="history"/>@T["StockMovements"]</h2><partial name="_ListSearch" model="@(new SearchBox(T["ListMovementSearch"].Value, ""))"/><partial name="_ListFilters"/><div class="table-responsive"><table class="table"><caption class="visually-hidden">@T["StockMovements"]</caption><thead><tr><th scope="col">@T["Date"]</th><th scope="col">@T["MovementKind"]</th><th scope="col">@T["Quantity"]</th><th scope="col">@T["StockBalance"]</th><th scope="col">@T["MovementReason"]</th><th scope="col">@T["User"]</th></tr></thead><tbody>@if(Model.Movements.Items.Count==0){<tr><td colspan="6">@T["ListNoMatches"]</td></tr>}@foreach(var row in Model.Movements.Items){<tr><td>@Clock.Local(row.LastUpdated).ToString("dd/MM/yyyy HH:mm")</td><td>@T["Stock"+row.Kind]</td><td>@row.Quantity.ToString("0.###")</td><td>@row.Balance.ToString("0.###")</td><td>@row.Reason</td><td>@Model.AccountNames.GetValueOrDefault(row.UpdatedById)</td></tr>}</tbody></table></div><partial name="_Pager"/></section>
