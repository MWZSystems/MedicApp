@model StockItemPage
@{ViewData["Title"]=T["StockMovements"];}
<div class="page-heading"><div><h1><medic-icon name="inventory"/>@Model.Item.Name</h1><p>@Model.Item.Code · @T["StockLot"]: @Model.Item.Lot · @T["ExpiresOn"]: @Model.Item.ExpiresOn?.ToString("dd/MM/yyyy")</p></div><a asp-action="Index" class="btn btn-outline-secondary"><medic-icon name="chevron-left"/>@T["Inventory"]</a></div>
<section class="panel"><h2 class="h4">@T["CurrentStock"]: @Model.Item.CurrentStock.ToString("0.###") @Model.Item.Unit</h2><p>@T["MinimumStock"]: @Model.Item.MinimumStock.ToString("0.###")</p><h2 class="h4"><medic-icon name="plus"/>@T["AddStockMovement"]</h2><p>@T["StockMovementHelp"]</p><div asp-validation-summary="All" class="text-danger"></div>
<form method="post" asp-action="Move" class="row g-3"><input type="hidden" name="StockItemId" value="@Model.Item.Id"/><input type="hidden" name="RequestKey" value="@Model.Form.RequestKey"/>
<div class="col-md-4"><label for="move-kind" class="form-label">@T["MovementKind"]</label><select id="move-kind" name="Kind" class="form-select">@foreach(var kind in Enum.GetValues<StockMovementKind>()){<option value="@((int)kind)" selected="@(kind==Model.Form.Kind)">@T["Stock"+kind]</option>}</select></div>
<div class="col-md-4"><label for="move-quantity" class="form-label">@T["Quantity"] (@Model.Item.Unit)</label><input id="move-quantity" name="Quantity" type="number" step="0.001" min="0.001" max="999999999" value="@Model.Form.Quantity.ToString("0.###",System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required/></div>
<div class="col-md-12"><label for="move-reason" class="form-label">@T["MovementReason"]</label><textarea id="move-reason" name="Reason" maxlength="1000" class="form-control" required>@Model.Form.Reason</textarea></div><div class="col-12"><button class="btn btn-primary"><medic-icon name="save"/>@T["Save"]</button></div></form></section>
<section class="panel"><h2 class="h4"><medic-icon name="history"/>@T["StockMovements"]</h2><div class="table-responsive"><table class="table"><thead><tr><th>@T["Date"]</th><th>@T["MovementKind"]</th><th>@T["Quantity"]</th><th>@T["StockBalance"]</th><th>@T["MovementReason"]</th><th>@T["User"]</th></tr></thead><tbody>@foreach(var row in Model.Movements.Items){<tr><td>@Clock.Local(row.LastUpdated).ToString("dd/MM/yyyy HH:mm")</td><td>@T["Stock"+row.Kind]</td><td>@row.Quantity.ToString("0.###")</td><td>@row.Balance.ToString("0.###")</td><td>@row.Reason</td><td>@Model.AccountNames.GetValueOrDefault(row.UpdatedById)</td></tr>}</tbody></table></div><nav class="pager"><span>@T["Total"]: @Model.Movements.Total</span>@if(Model.Movements.Page>1){<a class="btn btn-outline-secondary" asp-route-id="@Model.Item.Id" asp-route-page="@(Model.Movements.Page-1)">@T["Previous"]</a>}@if(Model.Movements.Page*25<Model.Movements.Total){<a class="btn btn-outline-secondary" asp-route-id="@Model.Item.Id" asp-route-page="@(Model.Movements.Page+1)">@T["Next"]</a>}</nav></section>
