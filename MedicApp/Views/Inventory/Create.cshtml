@model StockItemForm
@{ViewData["Title"]=T["AddStockItem"];}
<h1><medic-icon name="inventory"/>@T["AddStockItem"]</h1><p>@T["StockLotHelp"]</p><form method="post" class="panel"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Code" class="form-label">@T["StockCode"]</label><input asp-for="Code" class="form-control"/><span asp-validation-for="Code" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Name" class="form-label">@T["StockName"]</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Unit" class="form-label">@T["StockUnit"]</label><input asp-for="Unit" class="form-control"/><span asp-validation-for="Unit" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Lot" class="form-label">@T["StockLot"]</label><input asp-for="Lot" class="form-control"/><span asp-validation-for="Lot" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ExpiresOn" class="form-label">@T["ExpiresOn"]</label><input asp-for="ExpiresOn" type="date" class="form-control"/><span asp-validation-for="ExpiresOn" class="text-danger"></span></div><div class="col-md-6"><label asp-for="MinimumStock" class="form-label">@T["MinimumStock"]</label><input asp-for="MinimumStock" type="number" step="0.001" min="0" class="form-control"/><span asp-validation-for="MinimumStock" class="text-danger"></span></div></div><p class="mt-3">@T["StockInitialZero"]</p><button class="btn btn-primary"><medic-icon name="save"/>@T["Save"]</button> <a asp-action="Index" class="btn btn-outline-secondary">@T["Cancel"]</a></form>
