@model ClinicalVisitForm
@{ViewData["Title"]=T["AddClinicalVisit"];var person=(LeaveCalendarPerson)ViewBag.Person;}
<h1><medic-icon name="stethoscope"/>@T["AddClinicalVisit"]</h1><p>@person.Label</p><p class="alert alert-info">@T["ClinicalOptionalHelp"]</p>
<form method="post" class="panel"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="PersonId" type="hidden"/><input asp-for="RequestKey" type="hidden"/>
<div class="row g-3"><div class="col-md-5"><label asp-for="VisitedAt" class="form-label"><medic-icon name="calendar"/>@T["VisitDate"]</label><input asp-for="VisitedAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" required/></div></div>
<h2 class="h4 mt-4"><medic-icon name="heart"/>@T["VitalSigns"]</h2><div class="row g-3">
<div class="col-md-4"><label asp-for="Weight" class="form-label">@T["Weight"]</label><input asp-for="Weight" type="number" step="0.01" class="form-control"/><span asp-validation-for="Weight" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Height" class="form-label">@T["Height"]</label><input asp-for="Height" type="number" step="0.01" class="form-control"/><span asp-validation-for="Height" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Temperature" class="form-label">@T["Temperature"]</label><input asp-for="Temperature" type="number" step="0.01" class="form-control"/><span asp-validation-for="Temperature" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Systolic" class="form-label">@T["Systolic"]</label><input asp-for="Systolic" type="number" step="1" class="form-control"/><span asp-validation-for="Systolic" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Diastolic" class="form-label">@T["Diastolic"]</label><input asp-for="Diastolic" type="number" step="1" class="form-control"/><span asp-validation-for="Diastolic" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Pulse" class="form-label">@T["Pulse"]</label><input asp-for="Pulse" type="number" step="1" class="form-control"/><span asp-validation-for="Pulse" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="RespiratoryRate" class="form-label">@T["RespiratoryRate"]</label><input asp-for="RespiratoryRate" type="number" step="1" class="form-control"/><span asp-validation-for="RespiratoryRate" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="OxygenSaturation" class="form-label">@T["OxygenSaturation"]</label><input asp-for="OxygenSaturation" type="number" step="1" class="form-control"/><span asp-validation-for="OxygenSaturation" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Glucose" class="form-label">@T["Glucose"]</label><input asp-for="Glucose" type="number" step="0.01" class="form-control"/><span asp-validation-for="Glucose" class="text-danger"></span></div>
</div><h2 class="h4 mt-4"><medic-icon name="clipboard"/>@T["VisitDetails"]</h2><div class="row g-3"><div class="col-md-6"><label asp-for="Reason" class="form-label">@T["VisitReason"]</label><textarea asp-for="Reason" rows="4" class="form-control"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Findings" class="form-label">@T["Findings"]</label><textarea asp-for="Findings" rows="4" class="form-control"></textarea><span asp-validation-for="Findings" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Diagnosis" class="form-label">@T["Diagnosis"]</label><textarea asp-for="Diagnosis" rows="4" class="form-control"></textarea><span asp-validation-for="Diagnosis" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Treatment" class="form-label">@T["Treatment"]</label><textarea asp-for="Treatment" rows="4" class="form-control"></textarea><span asp-validation-for="Treatment" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Prescription" class="form-label">@T["Prescription"]</label><textarea asp-for="Prescription" rows="4" class="form-control"></textarea><span asp-validation-for="Prescription" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Notes" class="form-label">@T["ClinicalNotes"]</label><textarea asp-for="Notes" rows="4" class="form-control"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
</div><p class="small text-muted mt-3">@T["VisitAppendOnly"]</p><button class="btn btn-primary"><medic-icon name="save"/>@T["Save"]</button> <a asp-action="Index" asp-route-personId="@Model.PersonId" class="btn btn-outline-secondary"><medic-icon name="chevron-left"/>@T["Cancel"]</a></form>
