@model ListPage<AccessProfile>
@{ViewData["Title"]=T["Access"]; var names=(Dictionary<string,string>)ViewBag.AccountNames;}
<h1><medic-icon name="shield"/>@T["Access"]</h1><p>@T["PermissionsHelp"]</p><section class="panel"><h2>@T["Create"]</h2><p>@T["AccessAccountHelp"]</p><form method="post" class="row g-3"><div class="col-md-5"><label for="user" class="form-label"><medic-icon name="user"/>@T["User"]</label><select id="user" name="UserId" class="form-select" data-search-url="@Url.Action("Accounts")" required><option value="">@T["SearchHint"]</option></select></div><div class="col-md-5"><label><medic-icon name="stethoscope"/><input type="checkbox" name="ManageDoctors" value="true"/> @T["ManageDoctors"]</label><br/><label><medic-icon name="shield"/><input type="checkbox" name="ManageAccess" value="true"/> @T["ManageAccess"]</label><br/><label><medic-icon name="folder"/><input type="checkbox" name="ManageClinicalRecords" value="true"/> @T["ManageClinicalRecords"]</label><br/><label><medic-icon name="inventory"/><input type="checkbox" name="ManageInventory" value="true"/> @T["ManageInventory"]</label><br/><label><medic-icon name="refresh"/><input type="checkbox" name="ReadIntegration" value="true"/> @T["ReadIntegration"]</label></div><div class="col-md-2 align-self-end"><button class="btn btn-primary"><medic-icon name="save"/>@T["Save"]</button></div></form></section>
<section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th><medic-icon name="user"/>@T["User"]</th><th>@T["Access"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var row in Model.Items){<tr><td>@names.GetValueOrDefault(row.UserId)</td><td>@T["ManageDoctors"]: @row.ManageDoctors<br/>@T["ManageAccess"]: @row.ManageAccess<br/>@T["ManageClinicalRecords"]: @row.ManageClinicalRecords<br/>@T["ManageInventory"]: @row.ManageInventory<br/>@T["ReadIntegration"]: @row.ReadIntegration</td><td><form method="post" data-confirm="@T["ConfirmAction"]"><input type="hidden" name="UserId" value="@row.UserId"/><input type="hidden" name="Version" value="@Convert.ToBase64String(row.RowVersion)"/><label><medic-icon name="stethoscope"/><input type="checkbox" name="ManageDoctors" value="true" checked="@row.ManageDoctors"/> @T["ManageDoctors"]</label><br/><label><medic-icon name="shield"/><input type="checkbox" name="ManageAccess" value="true" checked="@row.ManageAccess"/> @T["ManageAccess"]</label><br/><label><medic-icon name="folder"/><input type="checkbox" name="ManageClinicalRecords" value="true" checked="@row.ManageClinicalRecords"/> @T["ManageClinicalRecords"]</label><br/><label><medic-icon name="inventory"/><input type="checkbox" name="ManageInventory" value="true" checked="@row.ManageInventory"/> @T["ManageInventory"]</label><br/><label><medic-icon name="refresh"/><input type="checkbox" name="ReadIntegration" value="true" checked="@row.ReadIntegration"/> @T["ReadIntegration"]</label><br/><button class="btn btn-outline-primary"><medic-icon name="save"/>@T["Save"]</button></form></td></tr>}</tbody></table></div><partial name="_Pager" model="Model"/></section>
