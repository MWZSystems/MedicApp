@model ListPage<AuditEntry>
@{ViewData["Title"]=T["Audit"]; var names=(Dictionary<string,string>)ViewBag.AccountNames;}
<h1><medic-icon name="history"/>@T["Audit"]</h1><section class="panel"><partial name="_ListSearch" model="@(new SearchBox(T["ListAuditSearch"].Value, ""))"/><partial name="_ListFilters"/><div class="table-responsive"><table class="table"><thead><tr><th>@T["UpdatedAt"]</th><th><medic-icon name="user"/>@T["User"]</th><th>@T["Entity"]</th><th>@T["Operation"]</th><th><medic-icon name="clipboard"/>@T["Reason"]</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="5">@T["ListNoMatches"]</td></tr>}@foreach(var row in Model.Items){<tr><td>@Clock.Local(row.LastUpdated).ToString("dd/MM/yyyy HH:mm")</td><td>@names.GetValueOrDefault(row.UpdatedById)</td><td>@row.EntityType #@row.EntityId</td><td>@row.Operation</td><td>@row.Reason</td></tr>}</tbody></table></div><partial name="_Pager"/></section>
