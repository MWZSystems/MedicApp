@model ListPage<Doctor>
@{ViewData["Title"]=T["Doctors"]; var names=Model.People;}
<h1>@T["Doctors"]</h1><section class="panel"><h2>@T["Create"]</h2><form asp-action="Doctor" method="post" class="row g-3"><input type="hidden" name="Available" value="true"/><div class="col-md-4"><label for="person" class="form-label">@T["Employee"]</label><select id="person" name="PersonId" data-search-url="@Url.Action("Search","People")" class="form-select" required><option value="">@T["SearchHint"]</option></select></div><div class="col-md-3"><label for="specialty" class="form-label">@T["Specialty"]</label><input id="specialty" name="Specialty" required maxlength="120" class="form-control"/></div><div class="col-md-3"><label for="license" class="form-label">@T["License"]</label><input id="license" name="ProfessionalLicense" required maxlength="60" class="form-control"/></div><div class="col-md-2 align-self-end"><button class="btn btn-primary">@T["Create"]</button></div></form></section>
<section class="panel"><div class="table-responsive"><table class="table" data-local-table><thead><tr><th>@T["Employee"]</th><th>@T["Specialty"]</th><th>@T["License"]</th><th>@T["Available"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(var row in Model.Items){<tr><td>@names.GetValueOrDefault(row.PersonId)</td><td>@row.Specialty</td><td>@row.ProfessionalLicense</td><td>@row.Available</td><td><details><summary>@T["Actions"]</summary><form asp-action="Doctor" method="post"><input type="hidden" name="Id" value="@row.Id"/><input type="hidden" name="PersonId" value="@row.PersonId"/><input type="hidden" name="Version" value="@Convert.ToBase64String(row.RowVersion)"/><label for="specialty-@row.Id">@T["Specialty"]</label><input id="specialty-@row.Id" name="Specialty" value="@row.Specialty" required maxlength="120" class="form-control"/><label for="license-@row.Id">@T["License"]</label><input id="license-@row.Id" name="ProfessionalLicense" value="@row.ProfessionalLicense" required maxlength="60" class="form-control"/><label for="active-@row.Id">@T["Available"]</label><select id="active-@row.Id" name="Available" class="form-select"><option value="true" selected="@row.Available">@T["Available"]</option><option value="false" selected="@(!row.Available)">@T["Disable"]</option></select><button class="btn btn-outline-primary mt-2">@T["Save"]</button></form></details></td></tr>}</tbody></table></div><partial name="_Pager" model="Model"/></section>
