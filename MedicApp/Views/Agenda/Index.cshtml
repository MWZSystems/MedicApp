@model WindowForm
@{ ViewData["Title"] = T["Agenda"]; }
<h1><medic-icon name="clock"/>@T["Agenda"]</h1><section class="panel"><h2><medic-icon name="plus"/>@T["CreateWindow"]</h2><form asp-action="Create" method="post" class="row g-3"><div class="col-md-4"><label asp-for="StartsAt" class="form-label"><medic-icon name="calendar"/>@T["Start"]</label><input asp-for="StartsAt" type="datetime-local" class="form-control" required/></div><div class="col-md-4"><label asp-for="EndsAt" class="form-label"><medic-icon name="calendar"/>@T["End"]</label><input asp-for="EndsAt" type="datetime-local" class="form-control" required/></div><div class="col-md-2"><label asp-for="SlotMinutes" class="form-label"><medic-icon name="clock"/>@T["SlotMinutes"]</label><input asp-for="SlotMinutes" class="form-control" min="5" max="30"/></div><div class="col-md-2 align-self-end"><button class="btn btn-primary"><medic-icon name="plus"/>@T["Create"]</button></div></form></section>
<section class="panel"><partial name="_ListSearch" model="@(new SearchBox(T["ListAgendaSearch"].Value, ""))"/><partial name="_ListFilters"/><div class="table-responsive"><table class="table"><thead><tr><th><medic-icon name="calendar"/>@T["Start"]</th><th><medic-icon name="calendar"/>@T["End"]</th><th><medic-icon name="clock"/>@T["SlotMinutes"]</th><th>@T["Actions"]</th></tr></thead><tbody>@if(((IReadOnlyList<AvailabilityWindow>)ViewBag.Windows).Count==0){<tr><td colspan="4">@T["ListNoMatches"]</td></tr>}@foreach(AvailabilityWindow row in ViewBag.Windows){<tr><td>@Clock.Local(row.StartsAt).ToString("dd/MM/yyyy HH:mm")</td><td>@Clock.Local(row.EndsAt).ToString("dd/MM/yyyy HH:mm")</td><td>@row.SlotMinutes</td><td>@if(row.Available){<form asp-action="Disable" method="post" data-confirm="@T["ConfirmAction"]"><input type="hidden" name="Id" value="@row.Id"/><input type="hidden" name="Version" value="@Convert.ToBase64String(row.RowVersion)"/><button class="btn btn-outline-danger"><medic-icon name="close"/>@T["Disable"]</button></form>}else{<span>@T["ListInactive"]</span>}</td></tr>}</tbody></table></div><partial name="_Pager"/></section>
