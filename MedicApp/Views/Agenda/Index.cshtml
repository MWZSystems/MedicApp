@model WindowForm
@{ ViewData["Title"] = T["Agenda"]; }
<h1><medic-icon name="clock"/>@T["Agenda"]</h1><section class="panel"><h2><medic-icon name="plus"/>@T["CreateWindow"]</h2><form asp-action="Create" method="post" class="row g-3"><div class="col-md-4"><label asp-for="StartsAt" class="form-label">@T["Start"]</label><input asp-for="StartsAt" type="datetime-local" class="form-control" required/></div><div class="col-md-4"><label asp-for="EndsAt" class="form-label">@T["End"]</label><input asp-for="EndsAt" type="datetime-local" class="form-control" required/></div><div class="col-md-2"><label asp-for="SlotMinutes" class="form-label">@T["SlotMinutes"]</label><input asp-for="SlotMinutes" class="form-control" min="5" max="30"/></div><div class="col-md-2 align-self-end"><button class="btn btn-primary"><medic-icon name="plus"/>@T["Create"]</button></div></form></section>
<section class="panel"><div class="table-responsive"><table class="table" data-local-table><thead><tr><th>@T["Start"]</th><th>@T["End"]</th><th>@T["SlotMinutes"]</th><th>@T["Actions"]</th></tr></thead><tbody>@foreach(AvailabilityWindow row in ViewBag.Windows){<tr><td>@Clock.Local(row.StartsAt).ToString("dd/MM/yyyy HH:mm")</td><td>@Clock.Local(row.EndsAt).ToString("dd/MM/yyyy HH:mm")</td><td>@row.SlotMinutes</td><td><form asp-action="Disable" method="post" data-confirm="@T["ConfirmAction"]"><input type="hidden" name="Id" value="@row.Id"/><input type="hidden" name="Version" value="@Convert.ToBase64String(row.RowVersion)"/><button class="btn btn-outline-danger"><medic-icon name="close"/>@T["Disable"]</button></form></td></tr>}</tbody></table></div></section>
