<div class="dropdown account-menu">
    <button type="button" class="account-toggle" id="account-menu" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@T["AccountMenu"]: @User.Identity?.Name" title="@T["AccountMenu"]">
        <span class="account-avatar"><medic-icon name="user"/></span>
        <span class="account-copy"><strong>@User.Identity?.Name</strong><small>@T["MySession"]</small></span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="account-menu">
        <li><a class="dropdown-item" asp-controller="Help" asp-action="Index"><medic-icon name="document"/>@T["HelpManual"]</a></li>
        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><medic-icon name="key"/>@T["ChangePassword"]</a></li>
        <li><hr class="dropdown-divider"/></li>
        <li><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="dropdown-item account-signout"><medic-icon name="logout"/>@T["Logout"]</button></form></li>
    </ul>
</div>
