@{
    var messages = Feedback.Take(TempData);
    if (!ViewData.ModelState.IsValid)
    {
        var general = ViewData.ModelState.Where(x => x.Key == "").SelectMany(x => x.Value!.Errors).Select(x => x.ErrorMessage).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToArray();
        foreach (var message in general.Length > 0 ? general : new[] { T["FeedbackInvalidForm"].Value })
        {
            var item = new FeedbackMessage(FeedbackKind.Error, message);
            if (!messages.Contains(item)) { messages.Add(item); }
        }
    }
    (string Kind, string Icon, string Title, int Timeout) Style(FeedbackKind kind) => kind switch
    {
        FeedbackKind.Success => ("success", "circle-check", "FeedbackSuccess", 5000),
        FeedbackKind.Info => ("info", "info", "FeedbackInfo", 7000),
        FeedbackKind.Warning => ("warning", "alert", "FeedbackWarning", 9000),
        _ => ("error", "circle-x", "FeedbackError", 0)
    };
}
<div class="toast-stack" id="toast-stack" aria-live="polite" aria-atomic="false" data-success-title="@T["FeedbackSuccess"]" data-info-title="@T["FeedbackInfo"]" data-warning-title="@T["FeedbackWarning"]" data-error-title="@T["FeedbackError"]" data-close-label="@T["FeedbackClose"]" data-icons-url="@Url.Content("~/branding/icons.svg")">
@foreach (var message in messages.OrderBy(x => x.Kind == FeedbackKind.Error ? 0 : 1))
{
    var style = Style(message.Kind);
    <div class="app-toast toast-@style.Kind" role="@(message.Kind is FeedbackKind.Error or FeedbackKind.Warning ? "alert" : "status")" data-kind="@style.Kind" data-timeout="@style.Timeout" tabindex="0">
        <span class="app-toast-icon"><medic-icon name="@style.Icon"/></span>
        <div class="app-toast-body"><div class="app-toast-title">@T[style.Title]</div><div class="app-toast-text">@T[message.Text]</div></div>
        <button type="button" class="app-toast-close" aria-label="@T["FeedbackClose"]"><medic-icon name="close"/></button>
    </div>
}
</div>
