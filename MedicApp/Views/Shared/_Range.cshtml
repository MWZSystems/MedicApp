<form method="get" class="filter-row"><div><label class="form-label" for="from"><medic-icon name="calendar"/>@T["From"]</label><input type="date" class="form-control" name="from" id="from" value="@Model.From.ToString("yyyy-MM-dd")"/></div><div><label class="form-label" for="to"><medic-icon name="calendar"/>@T["To"]</label><input type="date" class="form-control" name="to" id="to" value="@Model.To.ToString("yyyy-MM-dd")"/></div><button class="btn btn-outline-secondary"><medic-icon name="search"/>@T["Search"]</button></form>
