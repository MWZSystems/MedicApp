<div class="pager"><span>@T["Total"]: @Model.Total · @T["Page"] @Model.Page</span>@if(Model.Page>1){<a class="btn btn-outline-secondary" asp-route-page="@(Model.Page-1)" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">@T["Previous"]</a>}@if(Model.Page*25<Model.Total){<a class="btn btn-outline-secondary" asp-route-page="@(Model.Page+1)" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">@T["Next"]</a>}</div>
