@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authorization
@{
    var clinical = (await Authorization.AuthorizeAsync(User, "ClinicalRecords")).Succeeded;
    var inventory = (await Authorization.AuthorizeAsync(User, "Inventory")).Succeeded;
    var doctor = (await Authorization.AuthorizeAsync(User, "Doctor")).Succeeded;
    var doctors = (await Authorization.AuthorizeAsync(User, "Doctors")).Succeeded;
    var access = (await Authorization.AuthorizeAsync(User, "Access")).Succeeded;
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var medicalActive = current is "Appointments" or "Leaves" or "LeaveDocuments" or "Agenda";
    var resourcesActive = current is "ClinicalRecords" or "Inventory";
}
<nav class="navbar navbar-expand-xl app-nav" aria-label="@T["MainNavigation"]">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="@T["ToggleNavigation"]"><medic-icon name="list"/><span>@T["NavigationMenu"]</span></button>
    <div id="main-nav" class="collapse navbar-collapse">
        <div class="navbar-nav">
            <a class="nav-link @(current == "Home" ? "active" : null)" asp-controller="Home" asp-action="Index"><medic-icon name="home"/>@T["Home"]</a>
            <div class="nav-item dropdown">
                <button class="nav-link dropdown-toggle @(medicalActive ? "active" : null)" type="button" id="care-menu" data-bs-toggle="dropdown" aria-expanded="false"><medic-icon name="heart"/>@T["MedicalCareMenu"]</button>
                <ul class="dropdown-menu" aria-labelledby="care-menu">
                    <li><h2 class="dropdown-header">@T["Appointments"]</h2></li>
                    <li><a class="dropdown-item" asp-controller="Appointments" asp-action="Index"><medic-icon name="calendar"/>@T["AppointmentCalendarMenu"]</a></li>
                    @if (doctor){<li><a class="dropdown-item" asp-controller="Agenda" asp-action="Index"><medic-icon name="clock"/>@T["Agenda"]</a></li>}
                    <li><hr class="dropdown-divider"/></li>
                    <li><h2 class="dropdown-header">@T["Leaves"]</h2></li>
                    <li><a class="dropdown-item" asp-controller="Leaves" asp-action="Index"><medic-icon name="clipboard"/>@T["LeaveRegistry"]</a></li>
                    <li><a class="dropdown-item" asp-controller="Leaves" asp-action="Calendar"><medic-icon name="calendar"/>@T["LeaveCalendar"]</a></li>
                    <li><a class="dropdown-item" asp-controller="LeaveDocuments" asp-action="Record"><medic-icon name="folder"/>@T["PatientFile"]</a></li>
                </ul>
            </div>
            @if (clinical || inventory)
            {
                <div class="nav-item dropdown">
                    <button class="nav-link dropdown-toggle @(resourcesActive ? "active" : null)" type="button" id="resources-menu" data-bs-toggle="dropdown" aria-expanded="false"><medic-icon name="folder"/>@T["MedicalResourcesMenu"]</button>
                    <ul class="dropdown-menu" aria-labelledby="resources-menu">
                        @if(clinical){<li><a class="dropdown-item" asp-controller="ClinicalRecords" asp-action="Index"><medic-icon name="folder"/>@T["ClinicalRecords"]</a></li>}
                        @if(inventory){<li><a class="dropdown-item" asp-controller="Inventory" asp-action="Index"><medic-icon name="inventory"/>@T["Inventory"]</a></li>}
                    </ul>
                </div>
            }
            @if (doctors || access)
            {
                <div class="nav-item dropdown">
                    <button class="nav-link dropdown-toggle @(current == "Admin" ? "active" : null)" type="button" id="administration-menu" data-bs-toggle="dropdown" aria-expanded="false"><medic-icon name="shield"/>@T["ConfigurationAdministration"]</button>
                    <ul class="dropdown-menu" aria-labelledby="administration-menu">
                        @if(doctors){<li><a class="dropdown-item" asp-controller="Admin" asp-action="Doctors"><medic-icon name="stethoscope"/>@T["Doctors"]</a></li>}
                        @if(access){<li><a class="dropdown-item" asp-controller="Admin" asp-action="Access"><medic-icon name="shield"/>@T["Access"]</a></li><li><a class="dropdown-item" asp-controller="Admin" asp-action="Audit"><medic-icon name="history"/>@T["Audit"]</a></li>}
                    </ul>
                </div>
            }
            @if (access)
            {
                <div class="nav-item dropdown">
                    <button class="nav-link dropdown-toggle @(current == "Configuration" ? "active" : null)" type="button" id="configuration-menu" data-bs-toggle="dropdown" aria-expanded="false"><medic-icon name="settings"/>@T["Configuration"]</button>
                    <ul class="dropdown-menu" aria-labelledby="configuration-menu">
                        <li><a class="dropdown-item" asp-controller="Configuration" asp-action="Index"><medic-icon name="settings"/>@T["AllConfiguration"]</a></li>
                        <li><hr class="dropdown-divider"/></li>
                        <li><a class="dropdown-item" asp-controller="Configuration" asp-action="Index" asp-fragment="general"><medic-icon name="settings"/>@T["ConfigurationGeneral"]</a></li>
                        <li><a class="dropdown-item" asp-controller="Configuration" asp-action="Index" asp-fragment="appointments"><medic-icon name="calendar"/>@T["ConfigurationAppointments"]</a></li>
                        <li><a class="dropdown-item" asp-controller="Configuration" asp-action="Index" asp-fragment="documents"><medic-icon name="paperclip"/>@T["ConfigurationDocuments"]</a></li>
                        <li><a class="dropdown-item" asp-controller="Configuration" asp-action="Index" asp-fragment="clinical"><medic-icon name="folder"/>@T["ClinicalRecords"]</a></li>
                        <li><a class="dropdown-item" asp-controller="Configuration" asp-action="Index" asp-fragment="inventory"><medic-icon name="inventory"/>@T["Inventory"]</a></li>
                        <li><a class="dropdown-item" asp-controller="Configuration" asp-action="Index" asp-fragment="administration"><medic-icon name="shield"/>@T["ConfigurationAdministration"]</a></li>
                        <li><a class="dropdown-item" asp-controller="Configuration" asp-action="Index" asp-fragment="demo"><medic-icon name="info"/>@T["DemoData"]</a></li>
                    </ul>
                </div>
            }

        </div>
    </div>
</nav>
