@model CalendarPage
@{ ViewData["Title"] = T["Calendar"]; }
@section Styles {
  <link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true"/>
}
<section id="medical-calendar-page" data-events-url="@Url.Action("Events")" data-slots-url="@Url.Action("Slots")" data-initial-date="@Model.Date.ToString("yyyy-MM-dd")" data-today="@Model.Today.ToString("yyyy-MM-dd")" data-open-booking="@Model.OpenBooking.ToString().ToLowerInvariant()"
 data-auto-doctor="@T["AutoDoctorHelp"]" data-loading="@T["LoadingSlots"]" data-no-slots="@T["NoAgenda"]" data-select-time="@T["ChooseTime"]" data-request-error="@T["CalendarRequestError"]" data-today-label="@T["Today"]" data-month-label="@T["Month"]" data-week-label="@T["Week"]" data-day-label="@T["Day"]" data-list-label="@T["ListView"]" data-cancel="@T["Cancel"]" data-attended="@T["Attended"]" data-no-show="@T["NoShow"]" data-reason-required="@T["ReasonRequired"]">
  <div class="page-heading"><div><span class="eyebrow">@T["MedicalService"]</span><h1><medic-icon name="calendar"/>@(Model.IsDoctor ? T["DoctorCalendar"] : T["MyCalendar"])</h1><p class="text-muted mb-0">@T["CalendarHelp"]</p></div><div class="calendar-heading-actions"><a class="btn btn-outline-secondary" asp-action="List"><medic-icon name="list"/>@T["ViewList"]</a><a class="btn btn-primary" href="#booking-panel" id="focus-booking"><medic-icon name="plus"/>@T["Book"]</a></div></div>
  <div id="calendar-message" class="alert d-none" role="status" aria-live="polite"></div>
  <div class="calendar-workspace">
    <section class="panel calendar-panel"><div class="calendar-legend"><span><i class="legend-dot booked"></i>@T["Scheduled"]</span><span><i class="legend-dot attended"></i>@T["Attended"]</span><span><i class="legend-dot free"></i>@T["AvailableTimes"]</span></div><div id="appointments-calendar" aria-label="@T["Calendar"]"></div><noscript><p>@T["CalendarNeedsJavascript"] <a asp-action="List">@T["ViewList"]</a></p></noscript></section>
    <aside id="booking-panel" class="panel booking-panel" tabindex="-1" aria-labelledby="booking-title"><div class="booking-icon"><medic-icon name="calendar"/></div><h2 id="booking-title">@T["Book"]</h2><p class="text-muted">@T["SimpleBookingHelp"]</p>
      <form asp-action="Reserve" method="post" id="quick-booking-form"><input type="hidden" name="RequestKey" value="@Guid.NewGuid()"/>
        <div class="mb-3"><label for="booking-date" class="form-label"><medic-icon name="calendar"/>@T["Date"]</label><input id="booking-date" name="Date" type="date" required class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" min="@Model.Today.ToString("yyyy-MM-dd")" max="@Model.LastBookingDate.ToString("yyyy-MM-dd")"/></div>
        <div class="mb-3"><label for="booking-time" class="form-label"><medic-icon name="clock"/>@T["Time"]</label><select id="booking-time" name="Time" required class="form-select" data-select2="off"><option value="">@T["ChooseTime"]</option>@foreach(var slot in Model.Slots){<option value="@slot.StartsAtLocal.ToString("HH:mm")">@slot.StartsAtLocal.ToString("HH:mm")</option>}</select></div>
        <p id="slots-status" class="booking-help" role="status" aria-live="polite">@(Model.Slots.Count == 0 ? T["NoAgenda"] : T["AutoDoctorHelp"])</p>
        <button id="reserve-button" class="btn btn-primary w-100" disabled="@(Model.Slots.Count == 0)"><medic-icon name="check"/>@T["ConfirmBooking"]</button>
      </form>
      <div class="booking-person-note"><medic-icon name="user"/><span>@T["SessionBookingHelp"]</span></div>
      @if(Model.IsDoctor){<a class="btn btn-outline-secondary w-100 mt-3" asp-controller="Agenda" asp-action="Index"><medic-icon name="clock"/>@T["ManageAvailability"]</a>}
      <noscript><form method="get"><label for="fallback-date">@T["Date"]</label><input id="fallback-date" name="date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")"/><button class="btn btn-outline-secondary">@T["ShowTimes"]</button></form></noscript>
    </aside>
  </div>
  <div class="modal fade" id="appointment-detail" tabindex="-1" aria-labelledby="detail-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="detail-title"><medic-icon name="calendar"/>@T["AppointmentDetail"]</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button></div><div class="modal-body"><span id="detail-status" class="badge mb-3"></span><dl class="appointment-details"><dt><medic-icon name="user"/>@T["Employee"]</dt><dd id="detail-employee"></dd><dt><medic-icon name="users"/>@T["Doctor"]</dt><dd id="detail-doctor"></dd><dt><medic-icon name="clock"/>@T["DateAndTime"]</dt><dd id="detail-time"></dd></dl>
      <form asp-action="Change" method="post" id="calendar-change-form"><input type="hidden" name="Id"/><input type="hidden" name="Version"/><div class="mb-3"><label for="detail-action" class="form-label">@T["Action"]</label><select id="detail-action" name="Status" class="form-select" data-select2="off"></select></div><div id="detail-reason-group" class="mb-3"><label for="detail-reason" class="form-label">@T["Reason"]</label><input id="detail-reason" name="Reason" class="form-control" maxlength="500"/></div><div id="detail-error" class="text-danger mb-2" role="alert"></div><button class="btn btn-primary w-100"><medic-icon name="check"/>@T["Save"]</button></form>
    </div></div></div></div>
</section>
@section Scripts {
  <script src="~/lib/fullcalendar/index.global.min.js"></script><script src="~/lib/fullcalendar/locales-all.global.min.js"></script><script src="~/js/calendar.js" asp-append-version="true"></script>
}
