@model ListPage<Appointment>
@{ ViewData["Title"] = T["Appointments"]; }
<div class="page-heading"><h1>@T["Appointments"]</h1><a class="btn btn-primary" asp-action="Book">+ @T["Book"]</a></div><section class="panel"><partial name="_Range" model="Model"/><div class="table-responsive"><table class="table" data-local-table><thead><tr><th><medic-icon name="user"/>@T["Employee"]</th><th>@T["Doctor"]</th><th><medic-icon name="calendar"/>@T["Start"]</th><th><medic-icon name="calendar"/>@T["End"]</th><th><medic-icon name="info"/>@T["Status"]</th><th>@T["Actions"]</th></tr></thead><tbody>
@foreach(var row in Model.Items){<tr><td>@Model.People.GetValueOrDefault(row.PersonId)</td><td>@Model.Doctors.GetValueOrDefault(row.DoctorId)</td><td>@Clock.Local(row.StartsAt).ToString("dd/MM/yyyy HH:mm")</td><td>@Clock.Local(row.EndsAt).ToString("HH:mm")</td><td><span class="badge status-@row.Status">@T[row.Status.ToString()]</span></td><td>
@if(row.Status==AppointmentStatus.Scheduled){<details><summary>@T["Actions"]</summary><form asp-action="Change" method="post" data-confirm="@T["ConfirmAction"]" data-confirm-text="@T["ConfirmDetail"]"><input type="hidden" name="Id" value="@row.Id"/><input type="hidden" name="Version" value="@Convert.ToBase64String(row.RowVersion)"/><label for="status-@row.Id" class="form-label"><medic-icon name="info"/>@T["Status"]</label><select name="Status" id="status-@row.Id" class="form-select"><option value="3">@T["Cancelled"]</option>@if(Model.CurrentDoctorId==row.DoctorId){<option value="2">@T["Attended"]</option><option value="4">@T["NoShow"]</option>}</select><label class="form-label" for="reason-@row.Id"><medic-icon name="clipboard"/>@T["Reason"]</label><input id="reason-@row.Id" name="Reason" maxlength="500" required class="form-control mb-2"/><button class="btn btn-outline-primary"><medic-icon name="save"/>@T["Save"]</button></form></details>}
</td></tr>}</tbody></table></div><partial name="_Pager" model="Model"/></section>
