@model LoginForm
@{ ViewData["Title"] = T["Login"]; }
<section class="panel login-panel"><div class="access-emblem"><medic-icon name="shield"/></div><span class="eyebrow">@T["MedicalService"]</span><h1>@T["Login"]</h1>
<form method="post"><div asp-validation-summary="ModelOnly" role="alert"></div><input type="hidden" asp-for="ReturnUrl"/>
<div class="mb-3"><label asp-for="Identifier" class="form-label">@T["Identifier"]</label><div class="input-group access-input"><span class="input-group-text"><medic-icon name="id-card"/></span><input asp-for="Identifier" class="form-control" autocomplete="username"/></div><span asp-validation-for="Identifier"></span></div>
<div class="mb-4"><label asp-for="Password" class="form-label">@T["Password"]</label><div class="input-group access-input"><span class="input-group-text"><medic-icon name="lock"/></span><input asp-for="Password" class="form-control" autocomplete="current-password"/><button type="button" class="btn btn-outline-secondary password-toggle" data-password-toggle="Password" data-show-label="@T["ShowPassword"]" data-hide-label="@T["HidePassword"]" aria-label="@T["ShowPassword"]" title="@T["ShowPassword"]" aria-controls="Password" aria-pressed="false" hidden><span data-password-show><medic-icon name="eye"/></span><span data-password-hide hidden><medic-icon name="eye-off"/></span><span data-password-label>@T["ShowPassword"]</span></button></div><span asp-validation-for="Password"></span></div>
<button class="btn btn-primary w-100"><medic-icon name="login"/>@T["Login"]</button></form></section>

@section Scripts {<script src="~/js/password-toggle.js" asp-append-version="true"></script>}
