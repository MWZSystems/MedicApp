@model PasswordForm
@{ ViewData["Title"] = T["ChangePassword"]; }
<section class="panel login-panel"><h1><medic-icon name="key"/>@T["ChangePassword"]</h1><form method="post"><div asp-validation-summary="All" role="alert"></div><div class="mb-3"><label asp-for="Current"><medic-icon name="lock"/>@T["CurrentPassword"]</label><input asp-for="Current" class="form-control" autocomplete="current-password"/></div><div class="mb-3"><label asp-for="Password"><medic-icon name="key"/>@T["NewPassword"]</label><input asp-for="Password" class="form-control" autocomplete="new-password"/></div><div class="mb-3"><label asp-for="Confirm"><medic-icon name="check"/>@T["ConfirmPassword"]</label><input asp-for="Confirm" class="form-control" autocomplete="new-password"/></div><button class="btn btn-primary"><medic-icon name="save"/>@T["Save"]</button></form></section>
