@{ ViewData["Title"] = T["Home"]; }
<section class="hero"><div class="hero-emblem"><medic-icon name="stethoscope"/></div><span class="eyebrow">@T["MedicalService"]</span><h1>@T["Welcome"]</h1><p>@T["WelcomeDetail"]</p><a class="btn btn-primary" asp-controller="Appointments" asp-action="Book"><medic-icon name="calendar"/>@T["Book"]<medic-icon name="arrow"/></a></section>
<div class="stats"><section class="panel"><span class="stat-label"><span class="stat-emblem"><medic-icon name="calendar"/></span>@T["PendingAppointments"]</span><div class="stat-number">@ViewBag.Appointments</div><a asp-controller="Appointments" asp-action="Index"><medic-icon name="calendar"/>@T["Appointments"]<medic-icon name="arrow"/></a></section><section class="panel"><span class="stat-label"><span class="stat-emblem"><medic-icon name="file-check"/></span>@T["ActiveLeaves"]</span><div class="stat-number">@ViewBag.Leaves</div><a asp-controller="Leaves" asp-action="Index"><medic-icon name="clipboard"/>@T["Leaves"]<medic-icon name="arrow"/></a></section></div>
<p class="text-muted"><medic-icon name="shield"/>@T["ClinicalPrivacy"]</p>

<p><a class="btn btn-outline-secondary" asp-controller="Help" asp-action="Index"><medic-icon name="document"/>@T["HelpManual"]</a></p>
