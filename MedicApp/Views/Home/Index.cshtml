@{ ViewData["Title"] = T["Home"]; }
<section class="hero"><div class="hero-emblem"><medic-icon name="stethoscope"/></div><span class="eyebrow">@T["MedicalService"]</span><h1>@T["Welcome"]</h1><p>@T["WelcomeDetail"]</p><a class="btn btn-primary" asp-controller="Appointments" asp-action="Book"><medic-icon name="calendar"/>@T["Book"]</a></section>
<div class="stats"><section class="panel"><span class="stat-label"><span class="stat-emblem"><medic-icon name="calendar"/></span>@T["PendingAppointments"]</span><div class="stat-number">@ViewBag.Appointments</div></section><section class="panel"><span class="stat-label"><span class="stat-emblem"><medic-icon name="file-check"/></span>@T["ActiveLeaves"]</span><div class="stat-number">@ViewBag.Leaves</div></section></div>
<p class="text-muted"><medic-icon name="shield"/>@T["ClinicalPrivacy"]</p>
